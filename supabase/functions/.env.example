# Supabase Edge Functions — required environment variables
# Copy to .env.local and fill in real values; deploy with `supabase secrets set --env-file .env.local`

# === Supabase (auto-injected, do not set manually) ===
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# === AI providers ===
GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key  # optional, only if used

# === Email (Resend) ===
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM=AdminMate AI <noreply@yourdomain.com>

# === LINE Messenger webhook ===
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# === WhatsApp Business webhook ===
WHATSAPP_API_TOKEN=your-whatsapp-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret

# === Cron / scheduled jobs ===
CRON_SECRET=generate-a-long-random-string

# === Fallback for platform webhooks when no company mapping is found ===
DEFAULT_COMPANY_ID=

# === Stripe billing (if used) ===
# STRIPE_SECRET_KEY=sk_test_or_live
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
