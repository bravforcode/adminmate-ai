#!/bin/bash
# Pre-commit hook: Secret scanning (cross-platform)
# Blocks commits containing potential secrets

SECRETS_PATTERNS=(
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9'  # JWT tokens
  'sk_live_'                                   # Stripe live keys
  'sk_test_'                                   # Stripe test keys
  'pk_live_'                                   # Stripe publishable keys
  'SG\.[A-Za-z0-9_-]{22,}'                   # SendGrid API keys
  'AKIA[A-Z0-9]{16}'                          # AWS access keys
  'AIza[A-Za-z0-9_-]{35}'                     # Google API keys
  'rk_live_'                                   # Razorpay live keys
)

FOUND_SECRETS=0
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

for pattern in "${SECRETS_PATTERNS[@]}"; do
  MATCHED=$(echo "$STAGED_FILES" | while read -r file; do
    # Skip scanning this hook file itself (avoids self-referential false positives)
    if [ "$file" = ".git-hooks/pre-commit" ] || [ "$file" = "$(git rev-parse --show-toplevel)/.git-hooks/pre-commit" ]; then
      continue
    fi
    if [ -f "$file" ] && grep -q "$pattern" "$file" 2>/dev/null; then
      echo "$file"
    fi
  done)
  if [ -n "$MATCHED" ]; then
    echo "⚠️  POTENTIAL SECRET FOUND: pattern '$pattern'"
    echo "   Files: $(echo "$MATCHED" | tr '\n' ', ')"
    FOUND_SECRETS=1
  fi
done

if [ $FOUND_SECRETS -eq 1 ]; then
  echo ""
  echo "❌ Commit blocked: potential secrets detected in staged files."
  echo ""
  echo "If these are false positives (e.g., test fixtures with local dev keys),"
  echo "you can bypass with: git commit --no-verify"
  echo ""
  echo "BUT: Verify the secrets are not production credentials."
  exit 1
fi

exit 0
